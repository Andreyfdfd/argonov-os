#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════
#  ARGONOV OS — единая точка входа
#  Кастомная оболочка для Termux на Android
# ═══════════════════════════════════════════════════════

ARGONOV_VERSION="1.0.0"
ARGONOV_DIR="$HOME/.argonov"
BACKUP_DIR="$HOME/argonov_backups"

# ═══ ANSI цвета ═══
G="\033[92m"; DG="\033[32m"; C="\033[96m"; B="\033[94m"
M="\033[95m"; Y="\033[93m"; R="\033[91m"; W="\033[97m"
DIM="\033[2m"; BLD="\033[1m"; RST="\033[0m"

# ═══ Заголовок ═══
header() {
    echo ""
    echo -e "${C}┌─────────────────────────────────────────────────┐${RST}"
    echo -e "${C}│${RST}          ${BLD}${W}⚡  A R G O N O V   O S  ⚡${RST}          ${C}│${RST}"
    echo -e "${C}│${RST}       ${DIM}Кастомная оболочка для Termux${RST}          ${C}│${RST}"
    echo -e "${C}│${RST}                ${DIM}v${ARGONOV_VERSION}${RST}                       ${C}│${RST}"
    echo -e "${C}└─────────────────────────────────────────────────┘${RST}"
    echo ""
}

# ═══ Справка ═══
show_help() {
    header
    echo -e "${M}[ ДОСТУПНЫЕ КОМАНДЫ ]:${RST}"
    echo -e "${G}═══════════════════════════════════════════════════════${RST}"
    echo ""
    echo -e "  ${Y}🤖 ${C}ai${RST}         — AI-ассистент (Qwen + exec)"
    echo -e "  ${Y}📈 ${C}crypto${RST}     — Крипта в реальном времени"
    echo -e "  ${Y}🎵 ${C}music${RST}      — Музыкальный плеер"
    echo -e "  ${Y}📌 ${C}todo${RST}       — Трекер задач"
    echo -e "  ${Y}📝 ${C}notes${RST}      — Заметки"
    echo -e "  ${Y}🔒 ${C}pm${RST}         — Менеджер паролей (AES-256)"
    echo -e "  ${Y}🎮 ${C}hack${RST}       — Хакерский мультитул"
    echo -e "  ${Y}📥 ${C}d${RST}          — Загрузчик файлов"
    echo -e "  ${Y}🌧  ${C}m${RST}          — Матрица"
    echo -e "  ${Y}🔐 ${C}p${RST}          — Генератор паролей"
    echo -e "  ${Y}⚡ ${C}s${RST}          — Центр управления (sysinfo)"
    echo -e "  ${Y}📦 ${C}util${RST}       — Сканер утилит"
    echo -e "  ${Y}🎨 ${C}art${RST}        — Картинка во весь экран"
    echo -e "  ${Y}📌 ${C}plate${RST}      — Плашка команд"
    echo ""
    echo -e "${M}[ СЛУЖЕБНЫЕ ]:${RST}"
    echo -e "${G}═══════════════════════════════════════════════════════${RST}"
    echo ""
    echo -e "  ${C}help${RST}       — Эта справка"
    echo -e "  ${C}version${RST}    — Показать версию"
    echo -e "  ${C}backup${RST}     — Бэкап всех данных в ${DIM}~/argonov_backups/${RST}"
    echo -e "  ${C}restore${RST}    — Восстановить из бэкапа"
    echo -e "  ${C}update${RST}     — Проверить обновления"
    echo -e "  ${C}doctor${RST}     — Проверка целостности сетапа"
    echo ""
    echo -e "${DIM}Использование:${RST} ${C}argonov <команда>${RST}"
    echo -e "${DIM}Пример:${RST}      ${C}argonov music${RST}"
    echo ""
}

# ═══ Меню (интерактив) ═══
show_menu() {
    while true; do
        header
        echo -e "  ${C}1${RST})  🤖  ai        — AI-ассистент"
        echo -e "  ${C}2${RST})  📈  crypto    — Крипта"
        echo -e "  ${C}3${RST})  🎵  music     — Музыка"
        echo -e "  ${C}4${RST})  📌  todo      — Задачи"
        echo -e "  ${C}5${RST})  📝  notes     — Заметки"
        echo -e "  ${C}6${RST})  🔒  pm        — Пароли"
        echo -e "  ${C}7${RST})  🎮  hack      — Хакерский тул"
        echo -e "  ${C}8${RST})  📥  d         — Загрузчик"
        echo -e "  ${C}9${RST})  🌧   m         — Матрица"
        echo -e "  ${C}10${RST}) 🔐  p         — Пароль"
        echo -e "  ${C}11${RST}) ⚡  s         — Sysinfo"
        echo -e "  ${C}12${RST}) 📦  util      — Утилиты"
        echo -e "  ${C}13${RST}) 🎨  art       — Картинка"
        echo ""
        echo -e "  ${C}h${RST})  ❓  Справка"
        echo -e "  ${C}q${RST})  🚪  Выход"
        echo ""
        echo -ne "${BLD}${M}╰─❯ ${RST}"
        read -r choice
        case "$choice" in
            1) run_ai ;;
            2) run_crypto ;;
            3) run_music ;;
            4) run_todo ;;
            5) run_notes ;;
            6) run_pm ;;
            7) run_hack ;;
            8) run_d ;;
            9) run_m ;;
            10) run_p ;;
            11) run_s ;;
            12) run_util ;;
            13) run_art ;;
            h|help) show_help; echo -ne "${DIM}Enter для продолжения...${RST}"; read -r ;;
            q|exit|quit) echo -e "${DIM}До связи! 🖖${RST}"; exit 0 ;;
            *) echo -e "${R}❌ Неизвестный выбор${RST}"; sleep 1 ;;
        esac
    done
}

# ═══ Команды ═══
check_py() {
    if [ ! -f "$1" ]; then
        echo -e "${R}❌ Файл не найден: $1${RST}"
        sleep 2
        return 1
    fi
    return 0
}

run_ai()      { check_py ~/ai.py && python ~/ai.py ; }
run_crypto()  { check_py ~/crypto_informer.py && python ~/crypto_informer.py ; }
run_music()   { check_py ~/randomaudio.py && python ~/randomaudio.py ; }
run_todo()    { check_py ~/todo.py && python ~/todo.py ; }
run_notes()   { check_py ~/notes.py && python ~/notes.py ; }
run_pm()      { check_py ~/passmanager.py && python ~/passmanager.py ; }
run_hack()    { check_py ~/hacktool.py && python ~/hacktool.py ; }
run_d()       { check_py ~/download_zone.py && python ~/download_zone.py ; }
run_m()       { check_py ~/matrix.py && python ~/matrix.py ; }
run_p()       { check_py ~/passgen.py && python ~/passgen.py ; }
run_s()       { check_py ~/sysinfo.py && python ~/sysinfo.py ; }
run_util()    { check_py ~/utils.py && python ~/utils.py ; }
run_art()     {
    if [ -f ~/fantasy.png ]; then
        command clear
        cols=$(tput cols)
        rows=$(tput lines)
        sw=$((cols - 2))
        sh=$((rows - 3))
        viu -w "$sw" -h "$sh" -b -t ~/fantasy.png
    else
        echo -e "${R}❌ ~/fantasy.png не найден${RST}"
        sleep 2
    fi
}

# ═══ Бэкап ═══
do_backup() {
    mkdir -p "$BACKUP_DIR"
    ts=$(date +%Y%m%d_%H%M%S)
    file="$BACKUP_DIR/argonov_backup_${ts}.tar.gz"

    echo -e "${Y}⚙ Создаю бэкап...${RST}"
    cd "$HOME" || exit 1
    tar -czf "$file" \
        --exclude='argonov_backups' \
        --exclude='.cache' \
        --exclude='.cargo' \
        --exclude='storage' \
        ai.py crypto_informer.py randomaudio.py todo.py notes.py \
        passmanager.py hacktool.py download_zone.py matrix.py passgen.py \
        sysinfo.py utils.py music_meta.py argonov \
        .ai_config.json .ai_context.json .crypto_watchlist.json \
        .todo.json .notes.json .pm.vault \
        .config/fish/config.fish \
        .termux/colors.properties .termux/termux.properties \
        music_cache ai_chats 2>/dev/null

    if [ -f "$file" ]; then
        size=$(du -h "$file" | cut -f1)
        echo -e "${G}✔ Бэкап создан:${RST} $file ${DIM}($size)${RST}"
    else
        echo -e "${R}❌ Не удалось создать бэкап${RST}"
    fi
    sleep 3
}

# ═══ Восстановление ═══
do_restore() {
    mkdir -p "$BACKUP_DIR"
    if [ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
        echo -e "${R}❌ Нет бэкапов в $BACKUP_DIR${RST}"; sleep 2; return
    fi
    echo -e "${Y}Доступные бэкапы:${RST}"
    ls -lh "$BACKUP_DIR"/*.tar.gz 2>/dev/null | awk '{print "  " $NF " (" $5 ")"}'
    echo ""
    echo -ne "${M}Введи полный путь к бэкапу> ${RST}"
    read -r bfile
    if [ -f "$bfile" ]; then
        echo -e "${Y}⚙ Восстанавливаю...${RST}"
        cd "$HOME" && tar -xzf "$bfile"
        echo -e "${G}✔ Восстановлено${RST}"
    else
        echo -e "${R}❌ Файл не найден${RST}"
    fi
    sleep 2
}

# ═══ Doctor — проверка ═══
do_doctor() {
    header
    echo -e "${M}[ ПРОВЕРКА ЦЕЛОСТНОСТИ ]:${RST}"
    echo -e "${G}═══════════════════════════════════════════════════════${RST}"
    echo ""

    check_file() {
        if [ -f "$1" ]; then
            echo -e "  ${G}✔${RST} $1"
        else
            echo -e "  ${R}✘${RST} $1 ${DIM}(отсутствует)${RST}"
        fi
    }
    check_cmd() {
        if command -v "$1" &>/dev/null; then
            echo -e "  ${G}✔${RST} $1"
        else
            echo -e "  ${R}✘${RST} $1 ${DIM}(не установлен)${RST}"
        fi
    }

    echo -e "${C}📂 Скрипты:${RST}"
    for f in ai.py crypto_informer.py randomaudio.py todo.py notes.py \
             passmanager.py hacktool.py download_zone.py matrix.py passgen.py \
             sysinfo.py utils.py music_meta.py argonov; do
        check_file "$HOME/$f"
    done

    echo ""
    echo -e "${C}⚙ Системные утилиты:${RST}"
    for c in python pip git fish starship llama-server viu chafa; do
        check_cmd "$c"
    done

    echo ""
    echo -e "${C}🧠 Модели:${RST}"
    for f in ~/*.gguf; do
        if [ -f "$f" ]; then
            sz=$(du -h "$f" | cut -f1)
            echo -e "  ${G}✔${RST} $(basename "$f") ${DIM}($sz)${RST}"
        fi
    done

    echo ""
    echo -e "${C}📁 Конфиги:${RST}"
    check_file "$HOME/.config/fish/config.fish"
    check_file "$HOME/.termux/colors.properties"
    check_file "$HOME/.termux/termux.properties"

    echo ""
    echo -ne "${DIM}Enter для возврата...${RST}"; read -r
}

# ═══ Update (заглушка) ═══
do_update() {
    header
    echo -e "${M}[ ОБНОВЛЕНИЕ ]:${RST}"
    echo -e "${G}═══════════════════════════════════════════════════════${RST}"
    echo ""
    echo -e "  Текущая версия: ${C}v${ARGONOV_VERSION}${RST}"
    echo -e "  ${DIM}Обновление появится, когда проект будет опубликован на GitHub${RST}"
    echo ""
    echo -ne "${DIM}Enter для возврата...${RST}"; read -r
}

# ═══ Диспетчер ═══
case "$1" in
    "")              show_menu ;;
    ai)              run_ai ;;
    crypto)          run_crypto ;;
    music)           run_music ;;
    todo)            shift; python ~/todo.py "$@" ;;
    notes)           run_notes ;;
    pm)              run_pm ;;
    hack)            run_hack ;;
    d|download)      run_d ;;
    m|matrix)        run_m ;;
    p|pass)          run_p ;;
    s|sysinfo)       run_s ;;
    util)            run_util ;;
    art)             run_art ;;
    plate)           python ~/sysinfo.py; echo ""; ;;
    help|-h|--help)  show_help ;;
    version|-v|--version) echo -e "${G}Argonov OS v${ARGONOV_VERSION}${RST}" ;;
    backup)          do_backup ;;
    restore)         do_restore ;;
    doctor)          do_doctor ;;
    update)          do_update ;;
    *)
        echo -e "${R}❌ Неизвестная команда: $1${RST}"
        echo -e "${DIM}Используй: ${C}argonov help${RST}"
        exit 1
        ;;
esac
